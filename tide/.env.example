# Values `tide wire` needs and cannot read from the containers.
# Copy to tide/.env (git-ignored, mode 600) and fill in; `make wire` loads it.

# qBittorrent Web UI login. Radarr and Sonarr use it to add the torrents they
# pick, follow them in the queue and remove them after the import.
TIDE_QBIT_USERNAME=admin
TIDE_QBIT_PASSWORD=

# Jellyfin API key (Dashboard → API Keys → +). Radarr and Sonarr use it to ask
# Jellyfin to rescan the folder of each movie or episode they import, and tide
# itself to set up JellyBridge and its library Discover in Jellyfin.
TIDE_JELLYFIN_API_KEY=

# Quality profile, by name, of Radarr and Sonarr that Seerr requests use and
# that prefers the releases in Portuguese (Brazil).
TIDE_QUALITY_PROFILE=HD-1080p

# Address of the host on the LAN. Seerr links each request to the Radarr or
# Sonarr web UI at this address, opened from the browser.
TIDE_LAN_HOST=192.168.1.10

# Optional. Where tide reaches each service from the host, by default on
# localhost at the port its docker-compose.yml publishes.
# TIDE_RADARR_URL=http://localhost:7878
# TIDE_SONARR_URL=http://localhost:8989
# TIDE_PROWLARR_URL=http://localhost:9696
# TIDE_SEERR_URL=http://localhost:5055
# TIDE_BAZARR_URL=http://localhost:6767
# TIDE_JELLYFIN_URL=http://localhost:8096

# Optional. The API key of each service. Left out, tide reads the one the
# service generated on its first start from its container (docker exec).
# TIDE_RADARR_API_KEY=
# TIDE_SONARR_API_KEY=
# TIDE_PROWLARR_API_KEY=
# TIDE_SEERR_API_KEY=
# TIDE_BAZARR_API_KEY=

# Optional. OpenSubtitles.com login (a free account at opensubtitles.com).
# Bazarr searches it for the Portuguese (Brazil) subtitles when both are set.
# It is the only provider tide enables, so without it Bazarr downloads none
# (see jellyfin/SUBTITLES.md).
# TIDE_OPENSUBTITLES_USERNAME=
# TIDE_OPENSUBTITLES_PASSWORD=
